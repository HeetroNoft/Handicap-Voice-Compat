{
	"schemaVersion": 1,
	"id": "handicapvoice",
	"version": "${version}",
	"name": "Handicap Voice Compat",
	"description": "Makes the Mute, Deaf and Partial Deafness handicaps from Handicap affect Simple Voice Chat.",
	"authors": [
		"Heet"
	],
	"license": "MIT",
	"icon": {
		"64": "logo-64.png",
		"128": "logo-128.png"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.handicapvoice.HandicapVoice"
		],
		"client": [
			"com.handicapvoice.client.HandicapVoiceClient"
		],
		"voicechat": [
			"com.handicapvoice.HandicapVoicePlugin"
		],
		"modmenu": [
			"com.handicapvoice.client.HandicapVoiceModMenu"
		]
	},
	"depends": {
		"fabricloader": "*",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*",
		"handicap": "*",
		"voicechat": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
